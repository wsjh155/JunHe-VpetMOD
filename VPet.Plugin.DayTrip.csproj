<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>VPet.Plugin.DayTrip</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWPF>True</UseWPF>
    <TargetFramework>netcoreapp8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>11.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="windaytripmain.baml" />
    <None Remove="windaytripsetting.baml" />
    <EmbeddedResource Include="windaytripmain.baml" LogicalName="windaytripmain.baml" />
    <EmbeddedResource Include="windaytripsetting.baml" LogicalName="windaytripsetting.baml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="VPet-Simulator.Windows.Interface" />
    <Reference Include="LinePutScript" />
    <Reference Include="LinePutScript.Localization.WPF" />
    <Reference Include="VPet-Simulator.Core" />
  </ItemGroup>
</Project>